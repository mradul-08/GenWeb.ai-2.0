# Copy to client/.env.local. Everything with VITE_ is bundled into the public
# JavaScript — never put secrets here. The build refuses VITE_ variables whose
# names or values look like secrets (SECRET, TOKEN, PASSWORD, private keys, …).
VITE_API_URL=http://localhost:3002

# Firebase web-app config (public by design): Firebase console → Project
# settings → Your apps → Web app. Required: API key, auth domain, project id,
# app id. Use a different Firebase project per environment:
#   local       client/.env.local
#   staging     Vercel → Environment Variables → Preview (staging project)
#   production  Vercel → Environment Variables → Production
# The server must verify tokens for the same project: FIREBASE_PROJECT_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
