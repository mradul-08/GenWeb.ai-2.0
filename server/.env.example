# Copy to server/.env and fill in. Never commit server/.env.

PORT=3002
CLIENT_URL=https://your-frontend.example        # exact frontend origin (CORS, CSRF, framing)
SERVER_URL=https://your-api.example             # public API origin (deploy URLs)
SITE_URL=https://your-frontend.example          # sent to OpenRouter as HTTP-Referer (optional)

# MongoDB — must be a replica set (Atlas clusters are) because credits and
# payments use transactions. MONGODB_URL is still accepted for old .env files.
MONGODB_URI=

# Where this process runs: production | staging | development | test.
# The server and scripts refuse to connect when the database does not fit:
#   - the production database (PRODUCTION_DB_HOSTS) only with APP_ENV=production
#   - a remote database with APP_ENV unset → refused (ambiguous)
#   - development/test → local databases only, unless ALLOW_REMOTE_DB=true
#     (still never the production database)
# Render production: APP_ENV=production. Render staging: APP_ENV=staging.
APP_ENV=development
# Optional: comma-separated production DB hosts; ".suffix" entries match a suffix.
# Default: .ayk95r2.mongodb.net (current production Atlas project).
PRODUCTION_DB_HOSTS=
ALLOW_REMOTE_DB=
JWT_SECRET=                                     # long random string; rotating it logs everyone out

# Firebase project used to verify sign-in ID tokens (defaults to genwebai-dca16)
FIREBASE_PROJECT_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks: URL https://<SERVER_URL>/api/payment/webhook,
# events order.paid + payment.captured, and this same secret.
RAZORPAY_WEBHOOK_SECRET=

# AI providers — up to 5 keys each (_1 … _5); unused ones may be left out.
GROQ_API_KEY_1=
MISTRAL_API_KEY_1=
ZHIPU_API_KEY_1=
CEREBRAS_API_KEY_1=
SAMBANOVA_API_KEY_1=
OPENROUTER_API_KEY_1=
CLOUDFLARE_API_KEY_1=
CLOUDFLARE_ACCOUNT_ID_1=
